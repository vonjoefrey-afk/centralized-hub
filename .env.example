# Firebase Configuration Template
# Copy this file to .env and fill in your actual Firebase project values
# DO NOT commit the .env file to version control

# Firebase API Key (from Firebase Console > Project Settings > General)
REACT_APP_FIREBASE_API_KEY=your_api_key_here

# Firebase Auth Domain (usually your-project-id.firebaseapp.com)
REACT_APP_FIREBASE_AUTH_DOMAIN=your_auth_domain_here

# Firebase Project ID (from Firebase Console)
REACT_APP_FIREBASE_PROJECT_ID=your_project_id_here

# Firebase Storage Bucket (usually your-project-id.firebasestorage.app)
REACT_APP_FIREBASE_STORAGE_BUCKET=your_storage_bucket_here

# Firebase Messaging Sender ID (from Firebase Console > Project Settings > Cloud Messaging)
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here

# Firebase App ID (from Firebase Console > Project Settings > General)
REACT_APP_FIREBASE_APP_ID=your_app_id_here

# Example values for your current project (replace with your actual values):
# REACT_APP_FIREBASE_API_KEY=AIzaSy...
# REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# REACT_APP_FIREBASE_PROJECT_ID=your-project
# REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# REACT_APP_FIREBASE_MESSAGING_SENDER_ID=1234567890
# REACT_APP_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
